PRICE_EDITOR_ADMIN_PASSWORD=replace-with-a-strong-local-password
PRICE_EDITOR_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional. Defaults to .local-data in the project root.
CO_BUILDER_DATA_DIR=

# Persistence defaults to local JSON + local immutable media.
CO_BUILDER_PERSISTENCE=local
# Server-only Supabase settings. Never use NEXT_PUBLIC_ for the service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SNAPSHOT_BUCKET=co-builder-snapshots
# Server-only HMAC secret used to anonymize rate-limit client keys.
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
