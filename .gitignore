# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tmp/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.tsbuildinfo
/output/
/.pnpm-store/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local persistent Builder data (never commit snapshots or price history)
.local-data/

# Supabase CLI connection metadata (may contain branch-specific URLs)
supabase/.temp/

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
